# Copy to .env and adjust. Never commit .env (it is git-ignored).
# All variables are prefixed with TREND_AGENT_. Values shown are the defaults.

# --- General -------------------------------------------------------------------------
TREND_AGENT_ENVIRONMENT=development
TREND_AGENT_LOG_LEVEL=INFO          # CLI shows WARNING+ unless run with -v
TREND_AGENT_LOG_FORMAT=json         # json | text

# --- Database (matches docker-compose.yml defaults) ----------------------------------
TREND_AGENT_DATABASE_URL=postgresql+psycopg://trend_agent:trend_agent_dev@127.0.0.1:5432/trend_agent
# Separate database used by the integration tests (created by scripts/postgres-init).
TREND_AGENT_TEST_DATABASE_URL=postgresql+psycopg://trend_agent:trend_agent_dev@127.0.0.1:5432/trend_agent_test

# --- HTTP resilience -----------------------------------------------------------------
TREND_AGENT_HTTP_TIMEOUT_SECONDS=15
TREND_AGENT_HTTP_MAX_ATTEMPTS=4
TREND_AGENT_HTTP_BACKOFF_BASE_SECONDS=0.5
TREND_AGENT_HTTP_BACKOFF_MAX_SECONDS=30
TREND_AGENT_INGESTION_MAX_CONCURRENCY=4
TREND_AGENT_INGESTION_FETCH_TIMEOUT_SECONDS=120

# --- YouTube Data API v3 -------------------------------------------------------------
# Create an API key in Google Cloud Console (APIs & Services > Credentials) for a project
# with "YouTube Data API v3" enabled. Restrict the key to that API.
TREND_AGENT_YOUTUBE_API_KEY=
TREND_AGENT_YOUTUBE_ENABLED=true
# Default allocation documented by Google; set to your project's actual quota.
TREND_AGENT_YOUTUBE_DAILY_UNIT_LIMIT=10000
TREND_AGENT_YOUTUBE_SEARCH_DAILY_CALL_LIMIT=100
TREND_AGENT_YOUTUBE_QUOTA_SAFETY_MARGIN_PCT=10
TREND_AGENT_YOUTUBE_QUOTA_TIMEZONE=America/Los_Angeles
TREND_AGENT_YOUTUBE_MAX_PAGES_PER_REQUEST=3
# Compliance controls - see docs/compliance.md before changing.
TREND_AGENT_YOUTUBE_PERSIST_STATISTICS=false
TREND_AGENT_YOUTUBE_PERSIST_DESCRIPTIONS=true
TREND_AGENT_YOUTUBE_METADATA_RETENTION_DAYS=30
TREND_AGENT_YOUTUBE_STATISTICS_RETENTION_DAYS=30

# --- Google Trends (official API is limited-access alpha) ----------------------------
TREND_AGENT_GOOGLE_TRENDS_ACCESS_MODE=disabled      # disabled | official_alpha
TREND_AGENT_GOOGLE_TRENDS_CREDENTIALS_FILE=
TREND_AGENT_GOOGLE_TRENDS_ENDPOINT=
# Leave empty until your access agreement's retention terms are known; empty = no storage.
TREND_AGENT_GOOGLE_TRENDS_RETENTION_DAYS=

# --- Phase 2: keyword discovery ------------------------------------------------------
# Directory holding discovery.yaml, seeds/ and sources/ (default ./config).
TREND_AGENT_DISCOVERY_CONFIG_DIR=
# Descriptive User-Agent sent to feeds and public APIs (Reddit requires one).
TREND_AGENT_HTTP_USER_AGENT=youtube-trend-agent/0.2 (keyword discovery; contact: you@example.com)
# Optional GitHub token (read-only, public repos) for 5,000 requests/hour instead of 60.
TREND_AGENT_GITHUB_TOKEN=
# Reddit OAuth "script/app-only" credentials; required for Reddit sources.
TREND_AGENT_REDDIT_CLIENT_ID=
TREND_AGENT_REDDIT_CLIENT_SECRET=

# --- Synthetic provider --------------------------------------------------------------
TREND_AGENT_MOCK_PROVIDER_ENABLED=true
TREND_AGENT_MOCK_SEED=20260101

# --- Phase 6: forecasting -------------------------------------------------------------
# Directory for checksummed model artifacts (JSON parameters + LightGBM text; never
# pickle). Default: artifact_dir in config/forecasting.yaml (var/forecast_models).
TREND_AGENT_FORECAST_ARTIFACT_DIR=

# --- Phase 7: recommendations, dashboard API, alerts ------------------------------------
# Bearer token shared by the API and the dashboard's server (never sent to browsers).
# Without it the API is a read-only public view and refuses private data and all writes.
TREND_AGENT_API_TOKEN=
# Browser origins allowed by CORS (comma-separated; "*" is ignored).
TREND_AGENT_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TREND_AGENT_DASHBOARD_USER=creator
# Serve the isolated synthetic demonstration instead of the database.
TREND_AGENT_DEMO_MODE=false
TREND_AGENT_DEMO_CACHE_PATH=
# Optional alert channels (unconfigured channels report "unconfigured"; nothing is assumed).
TREND_AGENT_SMTP_HOST=
TREND_AGENT_SMTP_PORT=587
TREND_AGENT_SMTP_USERNAME=
TREND_AGENT_SMTP_PASSWORD=
TREND_AGENT_ALERT_EMAIL_FROM=
TREND_AGENT_ALERT_EMAIL_TO=
TREND_AGENT_TELEGRAM_BOT_TOKEN=
TREND_AGENT_TELEGRAM_CHAT_ID=

# --- Phase 8: production guard, budgets, operations -----------------------------------
# With ENVIRONMENT=production the API, scheduler and worker refuse to start while any
# development secret or insecure setting remains (see `trend-agent system audit`):
# the default database password, a missing/short (<32 chars) API token, a missing
# TREND_AGENT_VERIFICATION_SIGNING_KEY, or DEMO_MODE=true.
TREND_AGENT_VERIFICATION_SIGNING_KEY=
# Budgets (measured from recorded spend; exhaustion degrades the operating mode).
TREND_AGENT_DAILY_API_BUDGET=9000           # provider units per UTC day, all providers
TREND_AGENT_DAILY_LLM_BUDGET=5.0            # estimated USD per UTC day
TREND_AGENT_MONTHLY_LLM_BUDGET=60.0         # estimated USD per calendar month
TREND_AGENT_MAX_RECOMMENDATIONS_PER_RUN=20
TREND_AGENT_MAX_ANALYSIS_REQUESTS_PER_TOPIC=2  # content analyses per topic per 24 h
TREND_AGENT_MAX_RETRIES=3                   # retries after the first attempt (retryable errors only)
TREND_AGENT_MAX_CONCURRENT_WORKERS=4
TREND_AGENT_BUDGET_WARNING_RATIO=0.8
TREND_AGENT_OPS_ALERT_COOLDOWN_MINUTES=60   # one notification per recurring alert per cooldown
# Directory with operations.yaml (schedule cadence); default ./config.
TREND_AGENT_OPERATIONS_CONFIG_DIR=

# --- Dashboard (frontend/ server environment, not the Python services) ----------------
# Mandatory when the dashboard runs in production (`next start`): HTTP Basic credentials.
DASHBOARD_BASIC_AUTH_USER=
DASHBOARD_BASIC_AUTH_PASSWORD=
